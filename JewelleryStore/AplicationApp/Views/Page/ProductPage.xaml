<UserControl x:Class="WPFApp.Views.Page.ProductPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPFApp.Views.Page"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" >
    <Grid Background="#F9FAFB" >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Панель управления -->
        <StackPanel Grid.Column="0"
                    Background="White"
                    
                    VerticalAlignment="Top"
                    >
            <TextBlock Text="📦 Управление" FontSize="18" FontWeight="Bold" Foreground="#1F2937" Margin="0,0,0,10"/>
            <Button Content="➕ Добавить"
                    Width="160"
                    Padding="6"
                    Background="#4F46E5"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="AddProductButton_Click"
                    Margin="10"/>

            <Button Content="✏️ Изменить"
                    Width="160"
                    Padding="6"
                    Background="#FBBF24"
                    Foreground="Black"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="EditProductButton_Click"
                    Margin="10"/>

            <Button Content="🗑 Удалить"
                    Width="160"
                    Padding="6"
                    Background="#EF4444"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Command="{Binding DeleteCommand}"
                    Margin="10"/>
        </StackPanel>

        <!-- Список продуктов -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <ListBox ItemsSource="{Binding FilteredProducts}"
                     SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                     Margin="10">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Pink" BorderThickness="1" CornerRadius="5" Padding="10" Margin="5">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding ImageUrl}" Width="100" Height="100" Stretch="Fill"/>
                                <StackPanel Margin="10">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16" />
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" MaxWidth="400" />
                                    <TextBlock Text="{Binding Price}"/>
                                    <TextBlock Text="{Binding Stock, StringFormat='В наличии: {0} шт.'}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>
    </Grid>
</UserControl>
