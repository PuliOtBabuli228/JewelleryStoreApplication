<UserControl x:Class="WPFApp.Views.Page.UserProfilePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPFApp.Views.Page"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="800"
             >
    
    <Border Padding="24" Background="#F9FAFB">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Личный кабинет -->
            <StackPanel Grid.Column="0" Background="White" >
                <TextBlock Text="👤 Личный кабинет" FontSize="22" FontWeight="Bold" Foreground="#1F2937" Margin="0,0,0,20"/>

                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Имя" FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding User.Username, UpdateSourceTrigger=PropertyChanged}" 
                             FontSize="14"
                             Padding="6"
                             BorderBrush="#D1D5DB" BorderThickness="1" />
                </StackPanel>

                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Email" FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding User.Email, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="14"
                             Padding="6"
                             BorderBrush="#D1D5DB" BorderThickness="1"/>
                </StackPanel>

                <Button Content="💾 Сохранить"
                        Command="{Binding UpdateCommand}"
                        Background="#4F46E5"
                        Foreground="White"
                        FontWeight="SemiBold"
                        Padding="10"
                        BorderThickness="0"
                        Cursor="Hand"
                        HorizontalAlignment="Left"
                        Width="160"
                        Margin="60,10,0,0"/>
            </StackPanel>

            <!-- Заказы -->
            <StackPanel Grid.Column="2">
                <TextBlock Text="📦 Мои заказы" FontSize="20" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,20"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Height="460">
                    <ItemsControl ItemsSource="{Binding Orders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E5E7EB"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Background="White"
                                        Padding="16"
                                        Margin="0,0,0,20"
                                        SnapsToDevicePixels="True"
                                        >
                                    <StackPanel>
                                        <!-- Заголовок заказа -->
                                        <DockPanel Margin="0,0,0,10">
                                            <TextBlock Text="{Binding OrderDate, StringFormat='📅 {0:dd MMM yyyy}'}"
                                                       FontSize="13"
                                                       Foreground="#6B7280"
                                                       Margin="0,0,16,0"/>

                                            <TextBlock Text="{Binding Status, StringFormat='Статус: {0}'}"
                                                       FontSize="13"
                                                       Foreground="#F59E0B"
                                                       Margin="0,0,16,0"/>

                                            <TextBlock Text="{Binding TotalAmount, StringFormat='Сумма: {0:N2} ₽'}"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       Foreground="#10B981"/>
                                        </DockPanel>

                                        <!-- Товары -->
                                        <TextBlock Text="🛍 Товары в заказе" FontSize="14" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6"/>

                                        <ItemsControl ItemsSource="{Binding OrderItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,2">
                                                        <TextBlock Text="•"
                                                                   FontSize="14"
                                                                   Margin="0,0,6,0"
                                                                   Foreground="#6B7280"/>
                                                        <TextBlock Text="{Binding Product.Name}"
                                                                   FontSize="14"
                                                                   Width="220"
                                                                   Foreground="#111827"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Quantity, StringFormat='×{0}'}"
                                                                   FontSize="13"
                                                                   Foreground="#6B7280"
                                                                   Margin="10,0,0,0"/>
                                                        <TextBlock Text="{Binding PricePerUnit, StringFormat='по {0:N2} ₽'}"
                                                                   FontSize="13"
                                                                   Foreground="#4B5563"
                                                                   Margin="10,0,0,0"/>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
