<UserControl x:Class="WPFApp.Views.Page.AdminUsersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPFApp.Views.Page"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="20" Background="#FAFAFA">
        <StackPanel>
            <TextBlock Text="Пользователи" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Margin="0,0,0,25" 
                       Foreground="#333"/>

            <ListView ItemsSource="{Binding Users}" 
          SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
          Background="Transparent"
          BorderThickness="0"
          Height="350"
          Margin="0,0,0,15"
          ScrollViewer.VerticalScrollBarVisibility="Auto">

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White"
                    BorderBrush="#DDD"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{Binding Username}" FontSize="16" FontWeight="Bold" Foreground="#2E3A59"/>
                                <TextBlock Text="{Binding Email}" FontSize="14" Foreground="#616161" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding Role, StringFormat=Роль: {0}}" FontSize="13" Foreground="#757575"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>


            <Button Content="Удалить пользователя" 
                    Command="{Binding DeleteUserCommand}" 
                    Width="180" 
                    Height="40"
                    Background="#E53935" 
                    Foreground="White" 
                    FontWeight="SemiBold"
                    HorizontalAlignment="Left"
                    Cursor="Hand"
                    Padding="5"
                    />
        </StackPanel>
    </Grid>
</UserControl>
