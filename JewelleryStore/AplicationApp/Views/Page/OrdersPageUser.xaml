<UserControl x:Class="WPFApp.Views.Page.OrdersPageUser"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPFApp.Views.Page"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#F0F2F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Text="📦 Мои заказы"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="#1F2937"
                   Margin="30,20,0,20"
                   Grid.Row="0"/>

        <!-- Список заказов -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <ItemsControl ItemsSource="{Binding Orders}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="10"
                                    Margin="0,0,0,20"
                                    Background="White"
                                    BorderBrush="#D1D5DB"
                                    BorderThickness="1"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Левая цветная лента -->
                                    <Border Grid.Column="0"
                                            Background="#4F46E5"
                                            CornerRadius="10,0,0,10"/>

                                    <!-- Контент заказа -->
                                    <StackPanel Grid.Column="1"
                                                
                                                Background="White"
                                                >
                                        <!-- Шапка -->
                                        <DockPanel>
                                            <TextBlock Text="{Binding OrderDate, StringFormat='📅 {0:dd MMM yyyy}'}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#6B7280"
                                                       Margin="0,0,16,0"/>

                                            <TextBlock Text="{Binding Status, StringFormat='Статус: {0}'}"
                                                       FontSize="13"
                                                       FontWeight="Normal"
                                                       Foreground="#F59E0B"
                                                       Margin="0,0,16,0"/>

                                            <TextBlock Text="{Binding TotalAmount, StringFormat='Сумма: {0:N2} ₽'}"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       Foreground="#10B981"/>
                                        </DockPanel>

                                        <!-- Divider -->
                                        <Separator Margin="0,4,0,6" Background="#E5E7EB" Height="1"/>

                                        <!-- Товары в заказе -->
                                        <ItemsControl ItemsSource="{Binding OrderItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,2">
                                                        <TextBlock Text="•"
                                                                   FontSize="14"
                                                                   Margin="0,0,6,0"
                                                                   Foreground="#6B7280"/>
                                                        <TextBlock Text="{Binding Product.Name}"
                                                                   FontSize="14"
                                                                   Foreground="#111827"
                                                                   FontWeight="Normal"
                                                                   Width="220"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Quantity, StringFormat='×{0}'}"
                                                                   FontSize="13"
                                                                   Foreground="#6B7280"
                                                                   Margin="10,0,0,0"/>
                                                        <TextBlock Text="{Binding PricePerUnit, StringFormat='по {0:N2} ₽'}"
                                                                   FontSize="13"
                                                                   Foreground="#4B5563"
                                                                   Margin="10,0,0,0"/>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
