<UserControl x:Class="WPFApp.Views.Page.ProductPageUser"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPFApp.Views.Page"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#F3F4F6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Text="🛍️ Каталог товаров"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="#111827"
                   Margin="30,20,0,10"
                   Grid.Row="0"/>

        <!-- Список товаров -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Products}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel IsItemsHost="True" Margin="10"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="14"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                Background="White"
                                Width="260"
                                Margin="10"
                                Padding="14">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12"
                                                  ShadowDepth="2"
                                                  Opacity="0.1"/>
                            </Border.Effect>

                            <StackPanel>
                                <Image Source="{Binding ImageUrl}"
                                       Height="150"
                                       Stretch="UniformToFill"
                                       Margin="0,0,0,12"
                                       ClipToBounds="True">
                                    <Image.Clip>
                                        <RectangleGeometry RadiusX="10" RadiusY="10" Rect="0,0,260,150"/>
                                    </Image.Clip>
                                </Image>

                                <TextBlock Text="{Binding Name}"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="#1F2937"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"/>

                                <TextBlock Text="{Binding Description}"
                                           FontSize="12"
                                           Foreground="#6B7280"
                                           TextWrapping="Wrap"
                                           MaxHeight="40"
                                           Margin="0,4,0,4"/>

                                <TextBlock Text="{Binding Price, StringFormat=Цена: {0:N2} ₽}"
                                           FontSize="14"
                                           Foreground="#10B981"
                                           FontWeight="SemiBold"/>

                                <Button Content="➕ Добавить в корзину"
                                        Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Background="#3B82F6"
                                        Foreground="White"
                                        FontWeight="SemiBold"
                                        FontSize="13"
                                        Margin="0,10,0,0"
                                        Padding="8,4"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        HorizontalAlignment="Stretch"
                                        />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Нижняя панель -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,20,10"
                    Grid.Row="2">
            <Button Content="🔄 Обновить"
                    Width="130"
                    Height="36"
                    Background="#F59E0B"
                    Foreground="White"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Padding="10,4"
                    />
        </StackPanel>
    </Grid>
</UserControl>
