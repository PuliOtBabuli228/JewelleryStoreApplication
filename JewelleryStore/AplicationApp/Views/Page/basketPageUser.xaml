<UserControl x:Class="WPFApp.Views.Page.basketPageUser"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPFApp.Views.Page"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid Background="#F3F4F6" >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Text="🧺 Корзина"
                   FontSize="28"
                   FontWeight="Bold"
                   Margin="30,20,0,20"
                   Foreground="#1E293B"
                   HorizontalAlignment="Left"
                   Grid.Row="0"/>

        <!-- Список товаров -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding CartItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White"
                                CornerRadius="14"
                                Margin="0,0,0,16"
                                Padding="18"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Фото -->
                                <Image Source="{Binding Product.ImageUrl}"
                                       Width="80" Height="80"
                                       Margin="0,0,15,0"
                                       Stretch="UniformToFill"
                                       VerticalAlignment="Center"
                                       ClipToBounds="True"
                                      />

                                <!-- Информация -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Product.Name}" 
                                               FontSize="16" 
                                               FontWeight="Bold" 
                                               Foreground="#111827"/>
                                    <TextBlock Text="{Binding Product.Description}" 
                                               FontSize="13" 
                                               Foreground="#6B7280"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Product.Price, StringFormat='Цена: {0:N2} ₽'}"
                                               FontSize="14" 
                                               FontWeight="SemiBold" 
                                               Foreground="#10B981"
                                               Margin="0,5,0,0"/>
                                </StackPanel>

                                <!-- Кол-во -->
                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="#F9FAFB"
                                           >
                                    <Button Content="−"
                                            Width="30" Height="30"
                                            FontSize="16"
                                            Background="#E5E7EB"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    <TextBlock Text="{Binding Quantity}" 
                                               FontSize="14"
                                               Width="30"
                                               TextAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="#374151"/>
                                    <Button Content="+" 
                                            Width="30" Height="30"
                                            FontSize="16"
                                            Background="#E5E7EB"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>

                                <!-- Удалить -->
                                <Button Grid.Column="3" 
                                        Content="🗑"
                                        Width="36" Height="36"
                                        Background="#EF4444"
                                        Foreground="White"
                                        FontSize="16"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Margin="10,0,0,0"
                                        Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Итоговая цена и кнопка -->
        <DockPanel Grid.Row="2" Margin="0,20,0,0" LastChildFill="False" VerticalAlignment="Center">
            <TextBlock DockPanel.Dock="Left"
                       Text="{Binding TotalPrice, StringFormat='Итого: {0:N2} ₽'}"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#111827"
                       VerticalAlignment="Center"/>

            <Button Content="🧾 Оформить заказ"
                    Margin="700,0,0,0"
                    Width="200" Height="45"
                    Background="#3B82F6"
                    Foreground="White"
                    FontWeight="SemiBold"
                    FontSize="15"
                    
                    BorderThickness="0"
                    Command="{Binding PlaceOrderCommand}"
                    HorizontalAlignment="Right"
                   />
        </DockPanel>
    </Grid>
</UserControl>
