<Window x:Class="WPFApp.Views.Windows.AddProduct"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFApp.Views.Windows"
        mc:Ignorable="d"
        Title="Добавить товар"
        Height="550"
        Width="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F9F8F6">

    <Border Margin="20"
            Padding="20"
            Background="White"
            CornerRadius="10"
            BorderBrush="#DDDDDD"
            BorderThickness="1">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="360">

            <TextBlock Text="Добавление изделия" FontSize="22" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center" Foreground="#333"/>

            <TextBlock Text="Название" FontWeight="SemiBold" Foreground="#444" Margin="0,5"/>
            <TextBox Text="{Binding Name}" Height="35" Margin="0,0,0,10" Padding="8" Background="#F5F7FA" BorderBrush="#C5CAE9" BorderThickness="1"/>

            <TextBlock Text="Описание" FontWeight="SemiBold" Foreground="#444" Margin="0,5"/>
            <TextBox Text="{Binding Description}" Height="70" AcceptsReturn="True" TextWrapping="Wrap"
                     Margin="0,0,0,10" Padding="8" Background="#F5F7FA" BorderBrush="#C5CAE9" BorderThickness="1"/>

            <TextBlock Text="Цена" FontWeight="SemiBold" Foreground="#444" Margin="0,5"/>
            <TextBox Text="{Binding Price}" Height="35" Margin="0,0,0,10" Padding="8" Background="#F5F7FA" BorderBrush="#C5CAE9" BorderThickness="1"/>

            <TextBlock Text="Количество на складе" FontWeight="SemiBold" Foreground="#444" Margin="0,5"/>
            <TextBox Text="{Binding Stock}" Height="35" Margin="0,0,0,20" Padding="8" Background="#F5F7FA" BorderBrush="#C5CAE9" BorderThickness="1"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                <Button Content="Выбрать изображение"
                        Command="{Binding SelectImageCommand}"
                        Background="#D4AF37"
                        Foreground="White"
                        FontWeight="SemiBold"
                        Width="160"
                        Height="35"
                        Margin="0,0,10,0"
                        BorderThickness="0"
                        Cursor="Hand"/>
                <Button Content="Сохранить"
                        Command="{Binding SaveCommand}"
                        Background="#D4AF37"
                        Foreground="White"
                        FontWeight="SemiBold"
                        Width="120"
                        Height="35"
                        BorderThickness="0"
                        Cursor="Hand"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
