<Window x:Class="WPFApp.Views.Windows.UserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFApp.Views.Windows"
        mc:Ignorable="d"
        Title="Панель пользователя"
        Icon="/Assets/Images/kosmos.ico"
        Height="800"
        Width="1300"    
        
        WindowStartupLocation="CenterScreen"
        Background="#F0F0F0">

    <Border Background="White"
            CornerRadius="10"
            BorderBrush="#E0E0E0"
            BorderThickness="1"
            Padding="8"
            Margin="10">
        <DockPanel LastChildFill="True">

            <!-- Верхняя панель -->
            <DockPanel DockPanel.Dock="Top"
                       Height="76"
                       Background="#FAFAFA"
                       LastChildFill="False"
                       Margin="0,0,0,8"
                       VerticalAlignment="Center"
                       >
                <DockPanel.Effect>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.15"/>
                </DockPanel.Effect>
                 
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0">
                    <Button Width="56"
                            Height="56"
                            Background="Transparent"
                            BorderThickness="0"
                            Margin="0,0,10,0"
                            Cursor="Hand"
                            Click="OpenProfilePage"
                            ToolTip="Профиль">
                        <Image Source="/Assets/Images/prof.png"
                               Width="54"
                               Height="64"/>
                    </Button>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center" Margin="450,0,0,0">
                    <Label Content="JewelleryStore" FontSize="48" HorizontalAlignment="Center"/>
                </StackPanel>
            </DockPanel>

            <!-- Боковое меню -->
            <StackPanel DockPanel.Dock="Left"
                        Width="200"
                        Background="#F7F7F7"
                        >
                <TextBlock Text="Меню"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="#3E3E3E"
                           Margin="0,0,0,16"/>

                <Button Content="Товары"
                        Height="40"
                        Margin="0,0,0,8"
                        Background="#D4AF37"
                        Foreground="#333"
                        BorderBrush="#D0D0D0"
                        FontWeight="Normal"
                        Click="OpenPRoductPage"
                        Cursor="Hand"/>

                <Button Content="Корзина"
                        Height="40"
                        Margin="0,0,0,8"
                        Background="#D4AF37"
                        Foreground="#333"
                        BorderBrush="#D0D0D0"
                        FontWeight="Normal"
                        Click="OpenBasketPAge"
                        Cursor="Hand"/>

                <Button Content="Заказы"
                        Height="40"
                        Margin="0,0,0,8"
                        Background="#D4AF37"
                        Foreground="#333"
                        BorderBrush="#D0D0D0"
                        FontWeight="Normal"
                        Click="OpenOrderClick"
                        Cursor="Hand"/>

                <Separator Margin="0,12"/>

                <Button Content="Выход"
                        Height="40"
                        Background="#D9534F"
                        Foreground="White"
                        FontWeight="Normal"
                        BorderThickness="0"
                        Click="AnloginClick"
                        Cursor="Hand"/>
            </StackPanel>

            <Frame x:Name="MainFrame"
                   Margin="8"
                   Background="White"
                   NavigationUIVisibility="Hidden"/>
        </DockPanel>
    </Border>
</Window>
