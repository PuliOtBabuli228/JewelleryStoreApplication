<Window x:Class="WPFApp.Views.Windows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFApp.Views.Windows"
        mc:Ignorable="d"
        Title="Авторизация"
        Icon="/Assets/Images/A.ico"
        Height="480"
        Width="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#FF1A1A1A">

    <Grid>
        <Border Background="#FFFDF5E6" CornerRadius="14" Padding="30" Margin="30" BorderBrush="#FFD4AF37" BorderThickness="1.5">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.4" Color="Black"/>
            </Border.Effect>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="280">
                <TextBlock Text="Добро пожаловать" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           Margin="0,0,0,30" 
                           HorizontalAlignment="Center"
                           Foreground="#D4AF37"/>

                <TextBlock Text="Логин" FontWeight="SemiBold" Width="260" Foreground="#5C4A1F"/>
                <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="0,4,0,16" 
                         Height="32" 
                         Width="260" 
                         Padding="4" 
                         VerticalContentAlignment="Center"
                         BorderBrush="#D4AF37"
                         BorderThickness="1"
                         Background="White"/>

                <TextBlock Text="Пароль" FontWeight="SemiBold" Width="260" Foreground="#5C4A1F"/>
                <PasswordBox x:Name="PasswordBox" 
                             Margin="0,4,0,16" 
                             Height="32"
                             PasswordChanged="PasswordBox_PasswordChanged" 
                             Width="260"
                             BorderBrush="#D4AF37"
                             BorderThickness="1"
                             Background="White"/>

                <Button Content="Войти"
                        Command="{Binding LoginCommand}"
                        Margin="0,10,0,0"
                        Background="#D4AF37"
                        Foreground="White"
                        Height="36"
                        FontWeight="Bold"
                        BorderBrush="#B38E22"
                        BorderThickness="1"
                        Cursor="Hand"/>

                <Button Content="Регистрация"
                        Click="OpenRegWindow"
                        Background="Transparent"
                        Foreground="#D4AF37"
                        Margin="0,10,0,0"
                        Height="34"
                        FontWeight="Bold"
                        BorderBrush="#D4AF37"
                        BorderThickness="1"
                        Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
