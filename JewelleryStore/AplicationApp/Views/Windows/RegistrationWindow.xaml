<Window x:Class="WPFApp.Views.Windows.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFApp.Views.Windows"
        mc:Ignorable="d"
        Title="Регистрация"
        Icon="/Assets/Images/A.ico"
        Height="580"
        Width="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#FF1A1A1A">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF1A1A1A" Offset="0"/>
                <GradientStop Color="#FF2C2C2C" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Border Width="340"
                Padding="30"
                Background="#FFFDF5E6"
                CornerRadius="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BorderBrush="#D4AF37"
                BorderThickness="1.5">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.4" Color="Black"/>
            </Border.Effect>

            <StackPanel>

                <TextBlock Text="Регистрация"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#D4AF37"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <TextBlock Text="Имя пользователя" FontWeight="SemiBold" Foreground="#5C4A1F"/>
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="0,5,0,15"
                         Height="36"
                         Padding="6"
                         FontSize="14"
                         Background="White"
                         BorderBrush="#D4AF37"
                         BorderThickness="1"/>

                <TextBlock Text="Email" FontWeight="SemiBold" Foreground="#5C4A1F"/>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="0,5,0,15"
                         Height="36"
                         Padding="6"
                         FontSize="14"
                         Background="White"
                         BorderBrush="#D4AF37"
                         BorderThickness="1"/>

                <TextBlock Text="Пароль" FontWeight="SemiBold" Foreground="#5C4A1F"/>
                <PasswordBox x:Name="PasswordBox"
                             Margin="0,5,0,15"
                             Height="36"
                             Padding="6"
                             FontSize="14"
                             Background="White"
                             BorderBrush="#D4AF37"
                             BorderThickness="1"
                             PasswordChanged="PasswordBox_PasswordChanged"/>

                <TextBlock Text="Подтвердите пароль" FontWeight="SemiBold" Foreground="#5C4A1F"/>
                <PasswordBox x:Name="ConfirmBox"
                             Margin="0,5,0,25"
                             Height="36"
                             Padding="6"
                             FontSize="14"
                             Background="White"
                             BorderBrush="#D4AF37"
                             BorderThickness="1"
                             PasswordChanged="ConfirmBox_PasswordChanged"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Зарегистрироваться"
                            Command="{Binding RegisterCommand}"
                            Width="160"
                            Height="40"
                            Background="#D4AF37"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="1"
                            BorderBrush="#B38E22"
                            Cursor="Hand"
                            Margin="0,0,10,0"/>

                    <Button Content="Войти"
                            Click="Button_Click"
                            Width="100"
                            Height="40"
                            Background="Transparent"
                            Foreground="#D4AF37"
                            FontWeight="Bold"
                            BorderBrush="#D4AF37"
                            BorderThickness="1"
                            Cursor="Hand"/>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</Window>
