<Window x:Class="WPFApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFApp"
        mc:Ignorable="d"
        Title="Главная панель"
        Icon="/Assets/Images/kosmos.ico"
        Height="650"
        Width="930"
        WindowStartupLocation="CenterScreen"
        Background="#F9F8F6">

    <Border Margin="10"
         Background="White"
         CornerRadius="10"
         BorderBrush="#DDDDDD"
         BorderThickness="1"
         Padding="15"
         >
        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="160"/>
            </Grid.ColumnDefinitions>

            <Image Source="/Assets/Images/logotype.png"
                Grid.Column="1"
                VerticalAlignment="Top"
                Margin="15,10,5,0"/>

            <!-- Верхняя панель с кнопками -->
            <StackPanel Orientation="Vertical"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Center"
                     Grid.Column="1"
                     Margin="3,0,0,20"
                     >



                <Button Content="Продукты"
                     Width="140"
                     Height="42"
                     Background="#D4AF37"
                     Foreground="#2E2E2E"
                     FontWeight="SemiBold"
                     FontSize="14"
                     BorderThickness="0"
                     Cursor="Hand"
                     Click="OpenProductClick"
                     Margin="8,8"
                     
                     />

                <Button Content="Пользователи"
                     Width="140"
                     Height="42"
                     Background="#D4AF37"
                     Foreground="#2E2E2E"
                     FontWeight="SemiBold"
                     FontSize="14"
                     BorderThickness="0"
                     Cursor="Hand"
                     Click="OpenUserClick"
                     Margin="8,8"
                     
                     />

                <Button Content="Заказы"
                     Width="140"
                     Height="42"
                     Background="#D4AF37"
                     Foreground="#2E2E2E"
                     FontWeight="SemiBold"
                     FontSize="14"
                     BorderThickness="0"
                     Cursor="Hand"
                     Click="OpenOrdersClick"
                     Margin="8,8"
                     
                     />
                <Button Content="Выход"
                     Width="140"
                     Height="42"
                     Background="#D4AF37"
                     Foreground="#2E2E2E"
                     FontWeight="SemiBold"
                     FontSize="14"
                     BorderThickness="0"
                     Cursor="Hand"
                     Click="Exit_click"
                     Margin="8,8"
                     
                     />

            </StackPanel>

            <!-- Фрейм для отображения страниц -->
            <Border Grid.Column="0"
                 CornerRadius="6"
                 Background="#FAFAFA"
                 BorderBrush="#E0E0E0"
                 BorderThickness="1"
                 >
                <Frame x:Name="MainFrame"
                    Background="Transparent"
                    NavigationUIVisibility="Hidden"/>
            </Border>
        </Grid>
    </Border>
</Window>
